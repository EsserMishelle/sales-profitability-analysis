              <calculation class='tableau' formula='IF RANK(([Calculation_6067994667941890]), &apos;asc&apos;) &lt;= 5 &#13;&#10;OR RANK(([Calculation_6067994667941890]), &apos;desc&apos;) &lt;= 5 &#13;&#10;THEN &quot;Keep&quot;&#13;&#10;END'>
