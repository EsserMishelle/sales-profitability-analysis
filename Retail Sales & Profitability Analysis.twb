              <calculation class='tableau' formula='IF SUM([Calculation_6067994635755520]) &gt;= WINDOW_AVG(SUM([Calculation_6067994635755520]))&#13;&#10;AND SUM([Calculation_6067994636591105]) &gt;= WINDOW_AVG(SUM([Calculation_6067994636591105])) THEN &quot;High Rev / High Profit&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([Calculation_6067994635755520]) &gt;= WINDOW_AVG(SUM([Calculation_6067994635755520]))&#13;&#10;AND SUM([Calculation_6067994636591105]) &lt; WINDOW_AVG(SUM([Calculation_6067994636591105])) THEN &quot;High Rev / Low Profit&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([Calculation_6067994635755520]) &lt; WINDOW_AVG(SUM([Calculation_6067994635755520]))&#13;&#10;AND SUM([Calculation_6067994636591105]) &gt;= WINDOW_AVG(SUM([Calculation_6067994636591105])) THEN &quot;Low Rev / High Profit&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Rev / Low Profit&quot;&#13;&#10;END'>
