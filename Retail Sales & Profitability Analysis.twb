      <aliases enabled='yes' />
      <column caption='AVG Profit Margin' datatype='real' name='[AVG Revenue (copy)_1105349620457474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6067994667941890])' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_6067994667941890]) - LOOKUP(ZN([Calculation_6067994667941890]), -1)) / ABS(LOOKUP(ZN([Calculation_6067994667941890]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Region Profit Margin' datatype='real' name='[Calculation_0669942582198282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{Fixed [Region]: &#13;&#10;    Sum([Calculation_6067994636591105])/Sum([Calculation_6067994635755520])&#13;&#10;}' />
      </column>
      <column caption='Profit Margin vs Regional (pp)' datatype='real' name='[Calculation_0669942603587595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_6067994636591105]) / SUM([Calculation_6067994635755520])&#13;&#10;-&#13;&#10;MIN([Calculation_0669942582198282])) * 100' />
      </column>
      <column caption='Profit Margin vs Regional (%)' datatype='real' name='[Calculation_0669942607159309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM([Calculation_6067994636591105]) / SUM([Calculation_6067994635755520]) &#13;&#10;- MIN([Calculation_0669942582198282])&#13;&#10;)&#13;&#10;/&#13;&#10;MIN([Calculation_0669942582198282])' />
      </column>
      <column caption='Country Profit Margin Flag Indicator' datatype='string' name='[Calculation_0669942630211601]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Profit Margin Difference State vs Regional  (copy)_0669942606540812] &gt; 0 THEN &quot;▲&quot;&#13;&#10;ELSE &quot;▼&quot;&#13;&#10;END' />
      </column>
      <column caption='AVG Revenue' datatype='real' name='[Calculation_0669942764371987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_6067994635755520])' />
      </column>
      <column caption='Revenue vs Avg Revenue' datatype='real' name='[Calculation_0669942774001689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6067994635755520])&#13;&#10;-&#13;&#10;WINDOW_AVG(SUM([Calculation_6067994635755520]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue vs Average Revenue Color' datatype='string' name='[Calculation_0669942774272027]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0669942774001689] &gt; 0 THEN &quot;Above Avg&quot;&#13;&#10;ELSE &quot;Below Avg&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue vs Profit Quadrant Logic' datatype='string' name='[Calculation_0669942776786973]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_6067994635755520]) &gt;= WINDOW_AVG(SUM([Calculation_6067994635755520]))&#13;&#10;AND SUM([Calculation_6067994636591105]) &gt;= WINDOW_AVG(SUM([Calculation_6067994636591105])) THEN &quot;High Rev / High Profit&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([Calculation_6067994635755520]) &gt;= WINDOW_AVG(SUM([Calculation_6067994635755520]))&#13;&#10;AND SUM([Calculation_6067994636591105]) &lt; WINDOW_AVG(SUM([Calculation_6067994636591105])) THEN &quot;High Rev / Low Profit&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([Calculation_6067994635755520]) &lt; WINDOW_AVG(SUM([Calculation_6067994635755520]))&#13;&#10;AND SUM([Calculation_6067994636591105]) &gt;= WINDOW_AVG(SUM([Calculation_6067994636591105])) THEN &quot;Low Rev / High Profit&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Rev / Low Profit&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Discount Rate Jitter' datatype='real' name='[Calculation_0669942788976672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Discount] + (Random()-.5)*0.01' />
      </column>
      <column caption='Customer Total Revenue (LOD)' datatype='real' name='[Calculation_0973133525803008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{Fixed [Customer ID] : SUM([Calculation_6067994635755520])}' />
      </column>
      <column caption='Underperforming Sub-Category Flag' datatype='integer' name='[Calculation_0973133538680834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_6067994667941890] &lt; 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Sub-Category Profit Margin' datatype='real' name='[Calculation_0973133539459075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Sub-Category] :&#13;&#10;    SUM([Calculation_6067994636591105]) / SUM([Calculation_6067994635755520])&#13;&#10;}' />
      </column>
      <column caption='Underperforming Sub-Category Count' datatype='integer' name='[Calculation_0973133539627012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_0973133539459075] &lt; 0 THEN [Sub-Category] END&#13;&#10;)' />
      </column>
      <column caption='Order Item ID' datatype='string' name='[Calculation_1351639758385152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Order ID]+&apos;-&apos;+[Product ID]' />
      </column>
      <column caption='Returned Items' datatype='integer' name='[Calculation_1351639759044609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID (Returns)]+ &apos;-&apos; +[Product ID (Returns)])' />
      </column>
      <column caption='Total Ordered Items' datatype='integer' name='[Calculation_1351639759757314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1351639758385152])' />
      </column>
      <column caption='Return Rate' datatype='real' name='[Calculation_1351639759941635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1351639759044609]/[Calculation_1351639759757314]' />
      </column>
      <column caption='all_returned _items' datatype='string' name='[Calculation_1351639761260548]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Order ID (Returns)]+ &apos;-&apos; +[Product ID (Returns)]' />
      </column>
      <column caption='Profit Margin Moving Avg' datatype='real' name='[Calculation_1395895361691648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_6067994667941890], -4, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit Margin Flag' datatype='string' name='[Calculation_1395895372066817]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6067994667941890] &gt;= 0 THEN &quot;Profitable&quot;&#13;&#10;ELSE &quot;Unprofitable&quot;&#13;&#10;END' />
      </column>
      <column caption='Sales Rep Full Name' datatype='string' name='[Calculation_1395895389868037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[First-Name]+ &apos; &apos;+ [Last-Name]' />
      </column>
      <column caption='Sales Rep Yearly Goal (Fixed)' datatype='real' name='[Calculation_1501448534138881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ Fixed [Calculation_1395895389868037]: Max([Monthly-Goal]*12) }' />
      </column>
      <column caption='Goal Performance Flag' datatype='string' name='[Calculation_1501448540991491]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_6067994635755520]) &gt;= MIN([Calculation_1501448534138881]) THEN &quot;Above Goal&quot;&#13;&#10;ELSE &quot;Below Goal&quot;&#13;&#10;END' />
      </column>
      <column caption='Sales Reps Achievement %' datatype='real' name='[Calculation_1501448542199812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6067994635755520]) / SUM([Calculation_1501448534138881])' />
      </column>
      <column caption='Sales Reps Gap to Goal' datatype='real' name='[Calculation_1501448543522821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_6067994635755520]) &lt; MIN([Calculation_1501448534138881]) THEN&#13;&#10;    MIN([Calculation_1501448534138881]) - SUM([Calculation_6067994635755520])&#13;&#10;END' />
      </column>
      <column caption='Top and Bottom 5 Revenue' datatype='string' name='[Calculation_1501448566235142]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(SUM([Calculation_6067994635755520]), &apos;asc&apos;) &lt;= 5 &#13;&#10;OR RANK(SUM([Calculation_6067994635755520]), &apos;desc&apos;) &lt;= 5 &#13;&#10;THEN &quot;Keep&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Real Revenue' datatype='real' name='[Calculation_6067994635755520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Unit Price]*(1-[Discount])' />
      </column>
      <column caption='Real Profit' datatype='real' name='[Calculation_6067994636591105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Unit Price]*(1-[Discount])-[Unit Cost])*[Quantity]' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_6067994667941890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6067994636591105])/SUM([Calculation_6067994635755520])' />
      </column>
      <column caption='Avg Profit per Order' datatype='real' name='[Calculation_6067994668548099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6067994636591105]) / COUNTD([Order ID])' />
      </column>
      <column caption='Avg Return Rate' datatype='real' name='[Calculation_6067994679730190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF NOT ISNULL([Returned]) THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Order ID] + [Product ID])' />
      </column>
      <column caption='Return Flag' datatype='integer' name='[Calculation_6067994684956687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Returned]) THEN 0 ELSE 1 END' />
      </column>
