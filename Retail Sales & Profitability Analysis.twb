    <worksheet name='Sales Rep Performance vs Goal'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#555555' fontname='Tableau Book' fontsize='12'>Sales Rep Performance vs Goal</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='National Retail Sales' name='federated.1b7vr310gb2yfm18vqic90agsqdg' />
          </datasources>
          <datasource-dependencies datasource='federated.1b7vr310gb2yfm18vqic90agsqdg'>
            <column caption='Sales Rep Full Name' datatype='string' name='[Calculation_1395895389868037]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[First-Name]+ &apos; &apos;+ [Last-Name]' />
            </column>
            <column caption='Sales Rep Yearly Goal (Fixed)' datatype='real' name='[Calculation_1501448534138881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ Fixed [Calculation_1395895389868037]: Max([Monthly-Goal]*12) }' />
            </column>
            <column caption='Goal Performance Flag' datatype='string' name='[Calculation_1501448540991491]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_6067994635755520]) &gt;= MIN([Calculation_1501448534138881]) THEN &quot;Above Goal&quot;&#13;&#10;ELSE &quot;Below Goal&quot;&#13;&#10;END' />
            </column>
            <column caption='Sales Reps Achievement %' datatype='real' name='[Calculation_1501448542199812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6067994635755520]) / SUM([Calculation_1501448534138881])' />
            </column>
            <column caption='Sales Reps Gap to Goal' datatype='real' name='[Calculation_1501448543522821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_6067994635755520]) &lt; MIN([Calculation_1501448534138881]) THEN&#13;&#10;    MIN([Calculation_1501448534138881]) - SUM([Calculation_6067994635755520])&#13;&#10;END' />
            </column>
            <column caption='Real Revenue' datatype='real' name='[Calculation_6067994635755520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unit Price]*(1-[Discount])' />
            </column>
            <column datatype='real' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='string' name='[First-Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Last-Name]' role='dimension' type='nominal' />
            <column datatype='real' name='[Monthly-Goal]' role='measure' type='quantitative' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column caption='Sales Rep 80% Yearly Goal' datatype='real' name='[Sales Rep 80% Monthly Goal (copy)_1501448527114240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1501448534138881] * 0.8' />
            </column>
            <column datatype='real' name='[Unit Price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1395895389868037]' derivation='None' name='[none:Calculation_1395895389868037:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1501448534138881]' derivation='Sum' name='[sum:Calculation_1501448534138881:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6067994635755520]' derivation='Sum' name='[sum:Calculation_6067994635755520:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales Rep 80% Monthly Goal (copy)_1501448527114240]' derivation='Sum' name='[sum:Sales Rep 80% Monthly Goal (copy)_1501448527114240:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1501448540991491]' derivation='User' name='[usr:Calculation_1501448540991491:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1501448542199812]' derivation='User' name='[usr:Calculation_1501448542199812:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1501448543522821]' derivation='User' name='[usr:Calculation_1501448543522821:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order Date]' derivation='Year' name='[yr:Order Date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1b7vr310gb2yfm18vqic90agsqdg].[yr:Order Date:ok]'>
            <groupfilter function='member' level='[yr:Order Date:ok]' member='2019' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1b7vr310gb2yfm18vqic90agsqdg].[none:Calculation_1395895389868037:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1b7vr310gb2yfm18vqic90agsqdg].[sum:Calculation_6067994635755520:qk]' shelf='rows' />
