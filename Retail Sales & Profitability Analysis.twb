    <worksheet name='Profitability by Product Category (Revenue Weighted)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f7a7f' fontsize='11'>Profitability by Sub-Category</run>
          </formatted-text>
