            </column>
            <column caption='Profit Margin vs Avg Profit Margin' datatype='real' name='[Revenue vs Avg Revenue (copy)_1105349619847168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6067994667941890])&#13;&#10;-&#13;&#10;WINDOW_AVG(([Calculation_6067994667941890]))'>
