      <table>
        <view>
          <datasources>
            <datasource caption='National Retail Sales' name='federated.1b7vr310gb2yfm18vqic90agsqdg' />
          </datasources>
          <datasource-dependencies datasource='federated.1b7vr310gb2yfm18vqic90agsqdg'>
            <column caption='Sub-Category Profit Margin' datatype='real' name='[Calculation_0973133539459075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Sub-Category] :&#13;&#10;    SUM([Calculation_6067994636591105]) / SUM([Calculation_6067994635755520])&#13;&#10;}' />
            </column>
            <column caption='Underperforming Sub-Category Count' datatype='integer' name='[Calculation_0973133539627012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_0973133539459075] &lt; 0 THEN [Sub-Category] END&#13;&#10;)' />
            </column>
            <column caption='Real Revenue' datatype='real' name='[Calculation_6067994635755520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unit Price]*(1-[Discount])' />
            </column>
            <column caption='Real Profit' datatype='real' name='[Calculation_6067994636591105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Unit Price]*(1-[Discount])-[Unit Cost])*[Quantity]' />
            </column>
            <column datatype='real' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[Unit Cost]' role='measure' type='quantitative' />
            <column datatype='real' name='[Unit Price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0973133539627012]' derivation='User' name='[usr:Calculation_0973133539627012:qk]' pivot='key' type='quantitative' />
