            <zone h='92500' id='7' param='vert' removable='false' type-v2='layout-flow' w='98400' x='800' y='6500'>
              <zone h='92500' id='1' param='vert' removable='false' type-v2='layout-flow' w='98400' x='800' y='6500'>
                <zone h='12625' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98400' x='800' y='6500' />
                <zone h='79875' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98400' x='800' y='19125'>
                  <flipboard active-id='10' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='Revenue growth is concentrated in Technology and Office Supplies, while profitability varies across sub-categories. across regions and sub-categories.' captured-sheet='Dashboard: Revenue and Profitability Overview' id='1' />
                      <story-point caption='Revenue and profit peak in 2019 due to rising order volume and stable customer spending behavior.' captured-sheet='Dashboard: Sales Trend' id='2' />
                      <story-point caption='Expanding customer demand and transaction activity are the primary drivers of business growth.' captured-sheet='Dashboard: Sales Trend (Storyboard)' id='6'>
                        <capturedDeltas>
                          <dashboard name='Dashboard: Sales Trend (Storyboard)'>
                            <zone id='71'>
                              <formatted-text>
                                <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>After a brief seasonal dip, revenue and profit growth accelerated significantly after 2017, driven primarily by increased order volume rather than higher average order value.</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='A small group of sub-categories drives a signifcicant portion of profitability, while several categories consistently underperform across regions and customer segments.' captured-sheet='Dashboard:  Profitability Overview (Storyboard)' id='3'>
                        <capturedDeltas>
                          <worksheet name='Profit Margin Distribution by Region'>
                            <selection-collection />
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Profitability declines sharply at higher discount levels, while several high-revenue categories continue to generate weak margin performance.' captured-sheet='Dashboard: Profitability Drivers and Risk Analysis (1)' id='4' />
                      <story-point caption='Profitability declines sharply at higher discount levels, while several high-revenue categories continue to generate weak margin performance.' captured-sheet='Dashboard: Profitability Drivers and Risk Analysis (2)' id='7' />
                      <story-point caption='High revenue does not always translate into strong profitability, highlighting the importance of balancing growth with margin performance.' captured-sheet='Dashboard: Revenue by Region' id='5' />
                      <story-point caption='This section evaluates sales representative performance against yearly revenue goals and the 80% target threshold.' captured-sheet='Dashboard: Sales Rep Performance' id='8' />
                      <story-point caption='Revenue growth accelerated across all regions from 2016 to 2019, with the West and East regions contributing the largest share of overall sales performance.' captured-sheet='Sales Revenue by Region Over Time' id='9'>
                        <capturedDeltas>
                          <worksheet name='Sales Revenue by Region Over Time'>
                            <style delta-type='added'>
                              <style-rule element='axis'>
                                <format attr='title' class='0' field='[federated.1b7vr310gb2yfm18vqic90agsqdg].[sum:Calculation_6067994635755520:qk]' scope='rows' value='Revenue' />
                              </style-rule>
                            </style>
                            <selection-collection />
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Here are some conclusion points.' captured-sheet='' id='10' />
                      <story-point caption='Strategic Recommendations' captured-sheet='' id='11' />
                    </story-points>
                  </flipboard>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='67875' id='11' story-point-id='10' type-v2='text' w='80600' x='8200' y='20625'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000'>Key Conclusions</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>• Revenue and profit increased steadily from 2016 to 2019, with the strongest performance occurring in 2019.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>• Growth was driven primarily by increasing order volume and stronger regional sales performance rather than large increases in average order value.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>• Technology and Office Supplies generated the largest revenue contribution, while several Furniture sub-categories underperformed in profitability.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>• Higher discount levels were strongly associated with declining profitability, with profits turning negative beyond approximately 20–25% discount ranges.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>• Regional analysis showed the West and East regions contributed the highest revenue growth over time.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontsize='12'>• Sales performance varied substantially across representatives, indicating opportunities for performance improvement and sales optimization. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='79625' hidden='true' id='12' story-point-id='11' type-v2='text' w='92400' x='3800' y='19375'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Recommendations</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Optimize Discount Strategy</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Reduce excessive discounting above 20–25% where profitability consistently declines. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Focus promotions on high-margin products rather than broad discount campaigns. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Prioritize High-Performing Categories</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Continue investing in Technology and strong Office Supplies sub-categories that consistently generate both high revenue and strong profit margins. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Reevaluate low-margin Furniture products such as Tables and Bookcases. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Improve Sales Performance Consistency</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Use top-performing sales representatives as benchmarks for training and sales strategy development. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Provide additional support and coaching to underperforming sales teams. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Expand High-Growth Regional Opportunities</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Increase marketing and operational focus in high-performing regions such as the West and East. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Investigate growth opportunities in lower-performing regions to improve market penetration. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Strengthen Customer Retention Strategy</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Identify high-value customers and develop loyalty or targeted retention programs. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Focus on long-term customer profitability rather than short-term sales volume alone.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{4F06B8A2-24E5-44A7-9A0B-0018DB227BA3}' />
    </dashboard>
  </dashboards>
