    <worksheet name='Impact of Discounts on Profitability'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f7a7f' fontsize='11'>Impact of Discounts on Profitability</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='National Retail Sales' name='federated.1b7vr310gb2yfm18vqic90agsqdg' />
          </datasources>
          <datasource-dependencies datasource='federated.1b7vr310gb2yfm18vqic90agsqdg'>
            <column caption='Discount Rate Jitter' datatype='real' name='[Calculation_0669942788976672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Discount] + (Random()-.5)*0.01' />
            </column>
            <column caption='Real Profit' datatype='real' name='[Calculation_6067994636591105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Unit Price]*(1-[Discount])-[Unit Cost])*[Quantity]' />
            </column>
