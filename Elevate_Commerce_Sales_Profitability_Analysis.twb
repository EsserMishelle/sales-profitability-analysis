            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Profit Margin vs Average Margin Color ' datatype='string' name='[Revenue vs Average Revenue Color (copy)_1105349620715523]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Revenue vs Avg Revenue (copy)_1105349619847168] &gt; 0 THEN &quot;Above Avg&quot;&#13;&#10;ELSE &quot;Below Avg&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
