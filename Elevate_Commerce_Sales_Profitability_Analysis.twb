    <dashboard name='Story: Profitability Insights' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#266799' fontname='Benton Sans Book'>Elevate Commerce Sales &amp; Profitability Drivers</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-description'>
          <format attr='border-width' id='story-description_6' value='0' />
          <format attr='border-style' id='story-description_6' value='none' />
          <format attr='border-width' id='story-description_7' value='0' />
          <format attr='background-color' id='story-description_7' value='#e6e6e6' />
          <format attr='border-style' id='story-description_7' value='none' />
          <format attr='font-style' id='story-description_7' value='normal' />
          <format attr='font-weight' id='story-description_7' value='normal' />
          <format attr='text-decoration' id='story-description_7' value='none' />
          <format attr='background-color' id='story-description_6' value='#f5f5f5' />
          <format attr='background-color' id='story-description_11' value='#f5f5f5d9' />
          <format attr='background-color' id='story-description_12' value='#f5f5f5e7' />
        </style-rule>
        <style-rule element='story-point-caption'>
          <format attr='width' value='605' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' preset-index='1' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='9' param='vert' removable='false' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone h='5500' id='10' type-v2='title' w='98400' x='800' y='1000'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='92500' id='7' param='vert' removable='false' type-v2='layout-flow' w='98400' x='800' y='6500'>
              <zone h='92500' id='1' param='vert' removable='false' type-v2='layout-flow' w='98400' x='800' y='6500'>
                <zone h='12625' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98400' x='800' y='6500' />
                <zone h='79875' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98400' x='800' y='19125'>
                  <flipboard active-id='10' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='Revenue growth is concentrated in Technology and Office Supplies, while profitability varies across sub-categories. across regions and sub-categories.' captured-sheet='Dashboard: Revenue and Profitability Overview' id='1' />
                      <story-point caption='Revenue and profit peak in 2019 due to rising order volume and stable customer spending behavior.' captured-sheet='Dashboard: Sales Trend' id='13' />
                      <story-point caption='Expanding customer demand and transaction activity are the primary drivers of business growth.' captured-sheet='Dashboard: Sales Trend (Storyboard)' id='18'>
                        <capturedDeltas>
                          <dashboard name='Dashboard: Sales Trend (Storyboard)'>
                            <zone id='71'>
                              <formatted-text>
                                <run fontsize='10'>After a brief seasonal dip, revenue and profit growth accelerate significantly after 2017, mainly because of order volume expansion rather than average order value increase.</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='A small group of sub-categories drives a signifcicant portion of profitability. Several categories consistently underperform across regions and customer segments.' captured-sheet='Dashboard:  Profitability Overview (Storyboard)' id='3'>
                        <capturedDeltas>
                          <worksheet name='Profit Margin Distribution by Region'>
                            <selection-collection />
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Profitability declines sharply at higher discount levels, while several high-revenue categories continue to generate weak margin performance.' captured-sheet='Dashboard: Profitability Drivers and Risk Analysis (1)' id='4' />
                      <story-point caption='Higher discount levels create greater variability and increased risk of negative-profit transactions. ' captured-sheet='Dashboard: Profitability Drivers and Risk Analysis (2)' id='7'>
                        <capturedDeltas>
                          <dashboard name='Dashboard: Profitability Drivers and Risk Analysis (2)'>
                            <zone id='80'>
                              <formatted-text>
                                <run fontcolor='#000000' fontsize='10'>Profitability declines as discount levels increase, with margins approaching break-even beyond the 25–30% range. </run>
                                <run>Æ&#10;&#10;</run>
                                <run fontcolor='#000000' fontsize='10'>Smaller discounts generate more stable and consistent profit outcomes. </run>
                                <run>Æ&#10;</run>
                                <run fontcolor='#000000' fontsize='10'>Occasional high-profit orders exist, but they are not representative of overall pricing performance.</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='High revenue does not always translate into strong profitability, highlighting the importance of balancing growth with margin performance.' captured-sheet='Dashboard: Profitability Drivers and Risk Analysis (4)' id='5' />
                      <story-point caption='Here is the sales representative performance against yearly revenue goals and the 80% target threshold.' captured-sheet='Dashboard: Sales Rep Performance' id='8' />
                      <story-point caption='Revenue growth accelerated across all regions from 2016 to 2019, with the West and East regions contributing the largest share of overall sales performance.' captured-sheet='Dashboard: Revenue by Region' id='9'>
                        <capturedDeltas>
                          <dashboard name='Dashboard: Revenue by Region'>
                            <zone id='4'>
                              <formatted-text>
                                <run fontcolor='#000000'>Regional revenue trends show steady long-term growth across all regions despite seasonal fluctuations.</run>
                                <run>Æ&#10;</run>
                                <run fontcolor='#000000'>The West region generated the strongest overall revenue contribution, while the East region also demonstrated significant growth momentum. The South and Central regions contributed smaller but steadily increasing revenue shares over time.</run>
                                <run>Æ&#10;</run>
                                <run fontcolor='#000000'>Revenue peaks become larger and more frequent toward 2019, reflecting earlier findings that company growth was driven by increasing order volume and improved sales performance in later years.</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='The analysis highlights opportunities to improve long-term profitability through pricing optimization, regional growth strategies, and targeted sales performance.' captured-sheet='Dashboard: Key Conclusion' id='10' />
                      <story-point caption='Strategic recommendations are identified to improve profitability, sales effectiveness, and long-term business growth.' captured-sheet='Dashboard: Strategic Recommendations' id='11' />
                    </story-points>
                  </flipboard>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{4F06B8A2-24E5-44A7-9A0B-0018DB227BA3}' />
    </dashboard>
  </dashboards>
